# Plantilla de variables de entorno de MangazX.
#
# 1. Copia este archivo a `.env.local` (NO se sube a GitHub).
# 2. Completa los valores con la configuración WEB de tu proyecto de Firebase:
#    Consola de Firebase > Configuración del proyecto > General > Tus apps > App web > "Configuración del SDK".
# 3. En Cloudflare Pages, define las mismas variables en Settings > Variables and secrets.
#
# Estos valores son PÚBLICOS (acaban en el JavaScript del navegador); la seguridad real
# la dan las reglas de `firestore.rules`. Aun así, nunca pongas aquí claves privadas,
# cuentas de servicio ni credenciales de Cloudflare R2.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Opcional (no lo usan Firestore ni la autenticación por correo):
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Opcional: `true` muestra los datos de demostración aunque Firebase esté configurado.
# Sin Firebase configurado se usan siempre. Con Firebase y sin esta variable, se leen datos reales.
VITE_USE_DEMO_DATA=
